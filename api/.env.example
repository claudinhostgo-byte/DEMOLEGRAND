# =====================================================================
#  Configuracion de la API unica de captura de leads
#  Copiar este archivo como  api/.env  y completar.
#  api/.env esta en .gitignore: las credenciales NO se suben al repo.
# =====================================================================

# --- Modo de operacion ------------------------------------------------
# mock      = no escribe en CRM, guarda en api/_data/leads.json (default demo)
# dataverse = crea el lead real en Dynamics 365
LEAD_MODE=mock

# --- Entorno Dynamics 365 / Dataverse ---------------------------------
# OJO: el scope del token lleva esta URL. Es aqui donde se decide en que
# entorno caen los leads. Confirmar el entorno antes de pasar a dataverse.
#   Produccion W-IT : https://w-it.crm2.dynamics.com
#   Demo Project Op.: https://demopo.crm2.dynamics.com
#   Demo vacio      : https://demopgc.crm2.dynamics.com
DV_URL=https://demopgc.crm2.dynamics.com
DV_API_VERSION=v9.2

# --- App Registration (Entra ID) --------------------------------------
# El App Registration debe estar dado de alta como Application User en el
# entorno de destino, con un rol de seguridad que permita crear Leads.
DV_TENANT_ID=00000000-0000-0000-0000-000000000000
DV_CLIENT_ID=00000000-0000-0000-0000-000000000000
DV_CLIENT_SECRET=pegar-aqui-el-secret

# --- Columnas personalizadas (OPCIONALES) -----------------------------
# Si el entorno tiene columnas propias para el origen, se declaran aqui y
# la API las llena sin tocar codigo. Dejar vacio si no existen: el origen
# igual queda en la descripcion del lead y en leadsourcecode.
FIELD_LANDING_CODE=
FIELD_UTM_SOURCE=
FIELD_UTM_CAMPAIGN=

# --- Servidor ---------------------------------------------------------
PORT=8080
